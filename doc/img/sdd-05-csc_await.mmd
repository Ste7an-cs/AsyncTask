classDiagram
    class Awaitable~T~ {
        -hub_ shared_ptr~ChannelHub~
        -queue_ shared_ptr~FiberChannel~
        +Awaitable(mode AwaitMode)
        +channel() shared_ptr
        +shared() shared_ptr~Awaitable~
        +setOnClose(fn)
        +await() Result~T~
        +await_for(timeout) Result~T~
        +resolve(v) bool
        +discardPending()
        +isClosed() bool
        +close()
        +close(error_code)
    }
    class AwaitMode {
        <<enum>>
        Queue
        State
    }
    class ChannelHub~T~ {
        +ChannelHub(mode AwaitMode)
        +push(v)
        +close(error_code)
        +attach(queue)
        +detach(queue)
        +notifyClosed(reason)
        +discard_pending()
        +setCapacity(n)
        +isState() bool
        -consumers_ vector~weak_ptr~FiberChannel~~
        -stateMode_ bool
        -latest_ unique_ptr~T~
        -guard_ AwaitableCloseGuard
    }
    class AwaitableCloseGuard {
        +set(fn)
        +run()
    }
    class AutoDisconnect {
        +on(sender, sig, slot)
        +add(connection)
        +addCleanup(fn)
        +untilExpired(awaitable)
        +untilSignal(obj, sig)
        +untilSignal(obj, sig, pred)
        +disconnectAll()
    }
    class Generator~T~ {
        +begin() Iterator
        +end() Iterator
        +next() Result~T~
        +close()
    }
    class FiberChannel~T~ {
        +push(v) status
        +pop(out) status
        +pop_wait_for(out, t) status
        +wait_peek(out) status
        +wait_peek_for(out, t) status
        +discard_pending()
        +setCapacity(n)
        +close()
        +close(error_code)
        -queue_ deque
        -mtx_ / cv_consumer_ / closed_
        -capacity_ / close_error_
    }
    class Result~T,E~ {
        +has_value() bool
        +value() T
        +error() E
        +value_or(d) T
    }
    class CoroAbstractSocket {
        +readAll() shared_ptr~Awaitable<QByteArray>~
        +waitForReadyRead() shared_ptr~Awaitable<void>~
        +waitForBytesWritten() shared_ptr~Awaitable<void>~
        +waitForConnected() shared_ptr~Awaitable<void>~
        +waitForDisconnected() shared_ptr~Awaitable<void>~
        +connectToHost(...) shared_ptr~Awaitable<void>~
        +disconnectFromHost() shared_ptr~Awaitable<void>~
    }
    class CoroTcpServer {
        +nextConnection() shared_ptr~Awaitable<QTcpSocket*>~
    }
    class CoroLocalSocket {
        +readAll()/waitForReadyRead()/waitForBytesWritten()
        +waitForConnected()/waitForDisconnected()
        +connectToServer()/disconnectFromServer()
    }
    class CoroLocalServer {
        +nextConnection() shared_ptr~Awaitable<QLocalSocket*>~
    }
    class CoroUdpSocket {
        +receiveDatagram() shared_ptr~Awaitable<QNetworkDatagram>~
    }
    class CoroSslSocket {
        +waitForEncrypted() shared_ptr~Awaitable<void>~
        +connectToHostEncrypted(...) shared_ptr~Awaitable<void>~
    }

    Awaitable --> ChannelHub
    Awaitable *-- FiberChannel
    ChannelHub o-- FiberChannel : consumers_ 弱引用表(State 模式下容量恒为1)
    ChannelHub *-- AwaitableCloseGuard
    ChannelHub ..> AwaitMode : 构造时确定模式
    Awaitable ..> Result : await 返回
    Generator o-- Awaitable : generate 接管
    CoroAbstractSocket ..> Awaitable : 方法返回
    CoroAbstractSocket ..> AutoDisconnect : 管理订阅
    CoroTcpServer ..> Awaitable
    CoroTcpServer ..> AutoDisconnect
    AutoDisconnect ..> Awaitable : untilExpired 挂钩