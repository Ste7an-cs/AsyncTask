        +await() Result~T~
        +await_for(timeout) Result~T~
        +resolve(v) bool
        +close()
        +close(error_code)
    }
    class AwaitableCloseGuard {
        +set(fn)
        +run()
    }
    class Generator~T~ {
        +begin() Iterator
        +end() Iterator
        +next() Result~T~
        +close()
    }
    class FiberChannel~T~ {
        +push(v) bool
        +pop() Result~T~
        +pop_wait_for(t) Result~T~
        +close()
        -q_ deque
        -mtx_ / cv_ / closed_
